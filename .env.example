# KI-Textimport: Server-Proxy (Cloudflare Worker). Standard-URL ist fest im Code eingebaut;
# nur setzen, wenn du einen anderen Endpoint testest:
# EXPO_PUBLIC_TERRANA_AI_PROXY_URL=https://terrana-ai-proxy.terrana.workers.dev
#
# EXPO_PUBLIC_ANTHROPIC_API_KEY — nicht mehr nötig (deprecated; Key liegt nur im Worker).

# RevenueCat öffentliche API-Keys (Plattformspezifisch, aus RevenueCat Dashboard)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
